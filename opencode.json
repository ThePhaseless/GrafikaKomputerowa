{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "environment": {
        "BROWSER": "chromium"
      }
    },
    "jupyter": {
      "type": "local",
      "command": ["uvx", "mcp-server-jupyter"]
    },
    "pdf-reader": {
      "type": "local",
      "command": ["bunx", "@sylphx/pdf-reader-mcp"]
    }
  }
}
